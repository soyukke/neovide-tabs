#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
notify_script="${script_dir}/nvterm-agent-notify"
settings_file="$(mktemp "${TMPDIR:-/tmp}/nvterm-claude-settings.XXXXXX")"

find_real_claude() {
  local candidate="${NVTERM_REAL_CLAUDE:-}"
  if [[ -n "$candidate" && -x "$candidate" && ! "$candidate" -ef "$0" ]]; then
    printf '%s\n' "$candidate"
    return 0
  fi

  local old_ifs="$IFS"
  IFS=:
  for dir in ${PATH:-}; do
    [[ -z "$dir" ]] && dir="."
    if [[ "$dir" == "$script_dir" || "$dir" == "${NVTERM_AGENT_SHIM_DIR:-}" ]]; then
      continue
    fi
    candidate="$dir/claude"
    if [[ -x "$candidate" && ! "$candidate" -ef "$0" ]]; then
      IFS="$old_ifs"
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  IFS="$old_ifs"
  return 1
}

cleanup() {
  rm -f "$settings_file"
}
trap cleanup EXIT

real_claude="$(find_real_claude)" || {
  echo "nvterm: claude not found in PATH" >&2
  exit 127
}

if [[ -z "${NVTERM_AGENT_STATUS_FILE:-}" ]]; then
  exec "$real_claude" "$@"
fi

python3 - "$notify_script" "$settings_file" <<'PY'
import json
import pathlib
import shlex
import sys

notify_script = sys.argv[1]
settings_file = pathlib.Path(sys.argv[2])

def hook(source, state):
    command = " ".join(["bash", shlex.quote(notify_script), source, state])
    return [
        {
            "hooks": [
                {
                    "type": "command",
                    "command": command,
                    "timeout": 5,
                }
            ]
        }
    ]

settings = {
    "hooks": {
        "UserPromptSubmit": hook("claude", "running"),
        "Notification": hook("claude", "needs_input"),
        "Stop": hook("claude", "done"),
    }
}

settings_file.write_text(json.dumps(settings, indent=2) + "\n")
PY

exec "$real_claude" --settings "$settings_file" "$@"
