#!/usr/bin/env bash
set -euo pipefail

if [[ -z "${IN_NIX_SHELL:-}" ]]; then
  exec nix develop --command ./scripts/native-update-install-smoke "$@"
fi

source_app="spikes/macos-shell/.build/package/Neovide Tabs.app"
test -d "$source_app"

smoke_root="$(mktemp -d "${TMPDIR:-/tmp}/neovide-tabs-update-smoke.XXXXXX")"
case "$smoke_root" in
  "${TMPDIR:-/tmp}"/neovide-tabs-update-smoke.*) ;;
  *)
    echo "refusing unexpected update smoke root: $smoke_root" >&2
    exit 70
    ;;
esac
trap 'rm -rf -- "$smoke_root"' EXIT INT TERM

applications="$smoke_root/Applications"
trash_root="$smoke_root/user/.Trash"
current="$applications/Neovide Tabs.app"
staged="$applications/.Neovide Tabs.update.smoke.app"
backup="$applications/.Neovide Tabs.previous.smoke.app"
trash="$trash_root/Neovide Tabs.previous.smoke.app"
mkdir -p "$applications" "$trash_root"
/usr/bin/ditto "$source_app" "$current"
/usr/bin/ditto "$source_app" "$staged"
printf 'staged\n' >"$staged/Contents/Resources/update-smoke-marker"
/usr/bin/codesign --force --sign - --options runtime --timestamp=none "$staged"

/bin/sleep 0.2 &
wait_pid=$!
scripts/apply-update "$current" "$staged" "$backup" "$trash" "$wait_pid" smoke
wait "$wait_pid" 2>/dev/null || true

test -f "$current/Contents/Resources/update-smoke-marker"
test ! -e "$staged"
test ! -e "$backup"
test -d "$trash"
test ! -e "$trash/Contents/Resources/update-smoke-marker"
/usr/bin/codesign --verify --deep --strict --verbose=2 "$current"

rollback_applications="$smoke_root/rollback/Applications"
rollback_trash_root="$smoke_root/rollback/user/.Trash"
rollback_current="$rollback_applications/Neovide Tabs.app"
rollback_staged="$rollback_applications/.Neovide Tabs.update.rollback.app"
rollback_backup="$rollback_applications/.Neovide Tabs.previous.rollback.app"
rollback_trash="$rollback_trash_root/Neovide Tabs.previous.rollback.app"
mkdir -p "$rollback_applications" "$rollback_trash_root"
/usr/bin/ditto "$source_app" "$rollback_current"
/usr/bin/ditto "$source_app" "$rollback_staged"
printf 'invalid\n' >"$rollback_staged/Contents/Resources/update-smoke-marker"

/bin/sleep 0.2 &
rollback_wait_pid=$!
if scripts/apply-update \
  "$rollback_current" \
  "$rollback_staged" \
  "$rollback_backup" \
  "$rollback_trash" \
  "$rollback_wait_pid" \
  smoke; then
  echo "invalid staged application unexpectedly installed" >&2
  exit 1
else
  test "$?" = 65
fi
wait "$rollback_wait_pid" 2>/dev/null || true

test -d "$rollback_current"
test ! -e "$rollback_current/Contents/Resources/update-smoke-marker"
test -f "$rollback_staged/Contents/Resources/update-smoke-marker"
test ! -e "$rollback_backup"
test ! -e "$rollback_trash"
/usr/bin/codesign --verify --deep --strict --verbose=2 "$rollback_current"
printf 'native update install smoke passed\n'
