#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
notify_script="${repo_root}/scripts/nvterm-agent-notify"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/neovide-tabs"
delegate_file="${state_dir}/codex-notify-delegate.json"

require_cmd() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "missing required command: $1" >&2
    exit 69
  fi
}

require_cmd jq
require_cmd python3

install_claude_hooks() {
  local settings="${HOME}/.claude/settings.json"
  mkdir -p "$(dirname "$settings")"
  if [[ ! -f "$settings" ]]; then
    printf '{}\n' > "$settings"
  fi

  local backup="${settings}.bak.$(date +%s)"
  cp "$settings" "$backup"

  local tmp
  tmp="$(mktemp)"
  jq \
    --arg running "bash $(printf '%q' "$notify_script") claude running" \
    --arg needs_input "bash $(printf '%q' "$notify_script") claude needs_input" \
    --arg done "bash $(printf '%q' "$notify_script") claude done" \
    '
    def hook($cmd):
      {
        "hooks": [
          {
            "type": "command",
            "command": $cmd,
            "timeout": 5
          }
        ]
      };
    def add_hook($event; $cmd):
      .hooks = (.hooks // {}) |
      .hooks[$event] = (
        ((.hooks[$event] // []) | map(select((.hooks[0].command // "") != $cmd)))
        + [hook($cmd)]
      );
    add_hook("UserPromptSubmit"; $running)
    | add_hook("Notification"; $needs_input)
    | add_hook("Stop"; $done)
    ' "$settings" > "$tmp"
  mv "$tmp" "$settings"
  echo "updated Claude Code hooks: $settings"
  echo "backup: $backup"
}

install_codex_notify() {
  local config="${HOME}/.codex/config.toml"
  mkdir -p "$(dirname "$config")" "$state_dir"
  if [[ ! -f "$config" ]]; then
    : > "$config"
  fi

  local backup="${config}.bak.$(date +%s)"
  cp "$config" "$backup"

  python3 - "$config" "$delegate_file" "$notify_script" <<'PY'
import json
import pathlib
import sys
import tomllib

config_path = pathlib.Path(sys.argv[1])
delegate_path = pathlib.Path(sys.argv[2])
notify_script = sys.argv[3]

raw = config_path.read_text()
try:
    data = tomllib.loads(raw) if raw.strip() else {}
except Exception:
    data = {}

old_notify = data.get("notify")
new_notify = [notify_script, "codex", "done"]

if isinstance(old_notify, list) and old_notify and old_notify != new_notify:
    delegate_path.write_text(json.dumps(old_notify, ensure_ascii=False, indent=2) + "\n")
    new_notify = [notify_script, "codex", "done", "--delegate", str(delegate_path)]

line = "notify = " + json.dumps(new_notify, ensure_ascii=False) + "\n"
lines = raw.splitlines(keepends=True)
out = []
replaced = False
in_table = False
inserted = False

for current in lines:
    stripped = current.strip()
    if stripped.startswith("[") and not replaced and not inserted:
        out.append(line)
        inserted = True
    if not in_table and stripped.startswith("notify") and stripped.split("=", 1)[0].strip() == "notify":
        if not replaced:
            out.append(line)
            replaced = True
        continue
    out.append(current)
    if stripped.startswith("["):
        in_table = True

if not replaced and not inserted:
    if out and not out[-1].endswith("\n"):
        out[-1] += "\n"
    out.append(line)

config_path.write_text("".join(out))
PY
  echo "updated Codex notify: $config"
  echo "backup: $backup"
  if [[ -f "$delegate_file" ]]; then
    echo "preserved previous Codex notify delegate: $delegate_file"
  fi
}

install_claude_hooks
install_codex_notify
