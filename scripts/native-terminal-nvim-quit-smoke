#!/usr/bin/env bash
set -euo pipefail

app="spikes/macos-shell/.build/NativeShellSpike"
result_file="spikes/macos-shell/.build/native-terminal-nvim-quit.result"

rm -f "$result_file"

NVTERM_NATIVE_SMOKE_SCENARIO=terminal-nvim-quit \
  NVTERM_NATIVE_SMOKE_RESULT="$result_file" \
  "$app" >"/tmp/neovide-tabs-terminal-nvim-quit.log" 2>&1

result=$(cat "$result_file")
echo "$result"
[[ "$result" == ok* ]]
